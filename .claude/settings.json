{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash portal/ensure-portal.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 content/_preflight.py --changed >&2 || exit 2"
          }
        ]
      }
    ]
  }
}
